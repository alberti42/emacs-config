+(defun markdown-ts--destination-file-name (url)
+  "Return URL as a local file name.
+Removes the pointy-bracket wrapper, then percent-decodes when
+`markdown-ts-percent-decode-destinations' is non-nil and URL actually
+contains a %XX escape -- so a literal `%' in a file name is left alone.
+`[a](<my file.md>)', `[a](my%20file.md)' and `[a](<my%20file.md>)' then
+all name the file `my file.md'.
+
+Percent-escapes encode UTF-8 bytes, so the unhexed string is decoded
+back to characters.  Without that step `Fo%CC%88rster.md' still finds
+its file, but visits it under the mojibake buffer name
+`Fo\\314\\210rster.md'."
+  (let ((path (markdown-ts--unbracket-destination url)))
+    (if (and markdown-ts-percent-decode-destinations
+             (string-match-p "%[0-9A-Fa-f][0-9A-Fa-f]" path))
+        (decode-coding-string (url-unhex-string path) 'utf-8)
+      path)))
+
