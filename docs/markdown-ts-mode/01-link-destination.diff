+(defun markdown-ts--unbracket-destination (url)
+  "Return URL without CommonMark's optional pointy-bracket wrapper.
+A link destination may be enclosed in `<...>', which is *mandatory* when
+it contains spaces (CommonMark 0.31.2, section 6.3 \"Links\").  The
+brackets are delimiters, not part of the destination."
+  (if (and (string-prefix-p "<" url) (string-suffix-p ">" url))
+      (substring url 1 -1)
+    url))
+
+(defun markdown-ts--destination-file-name (url)
+  "Return URL as a local file name.
+Removes the pointy-bracket wrapper and percent-decodes URL, so that both
+`[a](<my file.md>)' and `[a](my%20file.md)' name the file `my file.md'.
+Decoding happens only when URL actually contains a %XX escape, so a
+literal `%' in a file name is left alone."
+  (let ((path (markdown-ts--unbracket-destination url)))
+    (if (string-match-p "%[0-9A-Fa-f][0-9A-Fa-f]" path)
+        (url-unhex-string path)
+      path)))
 
