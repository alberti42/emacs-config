+(defun markdown-ts--unbracket-destination (url)
+  "Return URL without CommonMark's optional pointy-bracket wrapper.
+A link destination may be enclosed in `<...>', and must be when it
+contains spaces (CommonMark 0.31.2, section 6.3 \"Links\").  The brackets
+are delimiters, not part of the destination."
+  (if (and (string-prefix-p "<" url) (string-suffix-p ">" url))
+      (substring url 1 -1)
+    url))
+
