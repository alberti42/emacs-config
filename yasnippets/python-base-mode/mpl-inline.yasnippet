# -*- mode: snippet -*-
# contributor : Andrea Alberti <a.alberti82@gmail.com>
# name : MPL magic for inline graphics
# key : mpl-inline
# group: matplotlib
# --
inline_rc = {
    'figure.figsize': (8, 5),
    'figure.dpi': 120,
    'lines.antialiased': True,
    'patch.antialiased': True,
    'text.antialiased': True,
}
%matplotlib inline
%config InlineBackend.figure_format = '${1:svg}'
%config InlineBackend.rc = inline_rc
$0