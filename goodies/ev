#!/bin/zsh
# ev — open files in a running Emacs vterm instance
#
# Usage: ev [-nw] [file]
#   ev file       open file in Emacs — non-blocking
#   ev -nw file   open file and block until C-c C-c — suitable as $EDITOR
#
# Blocking mode requires ev-open-file registered in vterm-eval-cmds;
# see terminal-config.el in the parent directory.

# Inline vterm_cmd: sends an OSC 51 escape sequence that vterm.el intercepts
# and dispatches as an Emacs function call.
_ev_vterm_cmd() {
    local args=""
    for arg in "$@"; do
        args+="$(printf '"%s" ' "$(printf '%s' "$arg" | sed -e 's|\\|\\\\|g' -e 's|"|\\"|g')")"
    done
    printf "\e]51;E%s\e\\" "$args" > /dev/tty
}

blocking=false
if [[ "$1" == "-nw" ]]; then
    blocking=true
    shift
fi

file="$(realpath "${1:-.}")"

if $blocking; then
    semaphore="$(mktemp)"
    rm -f "$semaphore"
    _ev_vterm_cmd ev-open-file "$file" "$semaphore"
    until [ -f "$semaphore" ]; do
        sleep 0.1
    done
    rm -f "$semaphore"
else
    _ev_vterm_cmd find-file "$file"
fi
